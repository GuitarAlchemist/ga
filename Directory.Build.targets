<Project>
  <!-- Ensures our NoWarn/RestoreNoWarn settings apply after project files, even if projects override them -->
  <PropertyGroup>
    <!-- Consolidated list of warnings to suppress solution-wide to achieve a clean baseline build. -->
    <NoWarn>$(NoWarn);
      NU1510;NU1902;NU1903;NU1904;NU1605;NU5104;
      CS8600;CS8601;CS8602;CS8603;CS8604;CS8618;CS8619;CS8620;CS8625;CS8629;CS8632;CS8714;CS8762;CS8767;CS8774;
      CS0649;CS0168;CS0105;CS0618;CS1570;CS1591;CS8425;
      IDE0161
    </NoWarn>
    <RestoreNoWarn>$(RestoreNoWarn);NU1510;NU1902;NU1903;NU1904;NU1605</RestoreNoWarn>
  </PropertyGroup>

  <!-- Blue/Green build slot support (opt-in per project via UseBlueGreenSlots in .csproj) -->
  <!-- Must be in .targets (not .props) so UseBlueGreenSlots from the project file is available -->
  <!-- Sets both OutputPath and OutDir to ensure the SDK doesn't override with defaults -->
  <PropertyGroup Condition="'$(UseBlueGreenSlots)' == 'true' AND Exists('$(MSBuildThisFileDirectory).slot-target')">
    <_SlotTarget>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory).slot-target').Trim())</_SlotTarget>
    <OutputPath>bin\$(_SlotTarget)\$(TargetFramework)\</OutputPath>
    <OutDir>$(OutputPath)</OutDir>
  </PropertyGroup>

  <!-- Centralized package version alignment and vulnerability remediation. These items are here, not in
       Directory.Build.props: MSBuild imports the props before a project's own PackageReference items, so an Update
       there finds nothing to update. An Update overrides the Version a project file writes, but only for a package
       the project references directly: it doesn't pin a transitive one -->
  <PropertyGroup>
    <MicrosoftExtensionsVersion>10.0.6</MicrosoftExtensionsVersion>
  </PropertyGroup>
  <ItemGroup>
    <!-- Security fixes -->
    <PackageReference Update="Newtonsoft.Json" Version="13.0.3"/>
    <PackageReference Update="System.Drawing.Common" Version="8.0.8"/>
    <PackageReference Update="System.Security.Cryptography.Xml" Version="8.0.1"/>
    <PackageReference Update="Microsoft.Build.Tasks.Core" Version="17.11.4"/>

    <!-- Version alignment to resolve downgrades -->
    <PackageReference Update="Microsoft.SemanticKernel" Version="1.38.0"/>
    <PackageReference Update="Microsoft.SemanticKernel.Core" Version="1.38.0"/>
    <PackageReference Update="Microsoft.SemanticKernel.Abstractions" Version="1.38.0"/>
    <!-- FSharp.Core version managed by the SDK — do not pin explicitly.
         F# projects get FSharp.Core from the SDK; C# projects consuming F#
         assemblies inherit the transitive reference automatically.
         Pinning here caused CS1705 when CI SDK shipped a newer FSharp.Core. -->

    <!-- MSB3277 conflict resolution -->
    <PackageReference Update="System.Numerics.Tensors" Version="10.0.2"/>
    <PackageReference Update="Microsoft.ML.OnnxRuntime" Version="1.23.2"/>

    <!-- Microsoft.Extensions.* version alignment for .NET 10: the packages that ship with .NET and ASP.NET Core,
         all at one version: the highest one a project or a package asks for (Microsoft.Extensions.AI 10.5.1 asks for
         10.0.6). A project that mixes 9.0 and 10.0 versions of them fails to restore (NU1107) -->
    <PackageReference Update="Microsoft.Extensions.Caching.Abstractions" Version="$(MicrosoftExtensionsVersion)"/>
    <PackageReference Update="Microsoft.Extensions.Caching.Memory" Version="$(MicrosoftExtensionsVersion)"/>
    <PackageReference Update="Microsoft.Extensions.Caching.StackExchangeRedis" Version="$(MicrosoftExtensionsVersion)"/>
    <PackageReference Update="Microsoft.Extensions.Configuration" Version="$(MicrosoftExtensionsVersion)"/>
    <PackageReference Update="Microsoft.Extensions.Configuration.Abstractions" Version="$(MicrosoftExtensionsVersion)"/>
    <PackageReference Update="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="$(MicrosoftExtensionsVersion)"/>
    <PackageReference Update="Microsoft.Extensions.Configuration.Json" Version="$(MicrosoftExtensionsVersion)"/>
    <PackageReference Update="Microsoft.Extensions.Configuration.UserSecrets" Version="$(MicrosoftExtensionsVersion)"/>
    <PackageReference Update="Microsoft.Extensions.DependencyInjection" Version="$(MicrosoftExtensionsVersion)"/>
    <PackageReference Update="Microsoft.Extensions.DependencyInjection.Abstractions" Version="$(MicrosoftExtensionsVersion)"/>
    <PackageReference Update="Microsoft.Extensions.Hosting" Version="$(MicrosoftExtensionsVersion)"/>
    <PackageReference Update="Microsoft.Extensions.Hosting.Abstractions" Version="$(MicrosoftExtensionsVersion)"/>
    <PackageReference Update="Microsoft.Extensions.Http" Version="$(MicrosoftExtensionsVersion)"/>
    <PackageReference Update="Microsoft.Extensions.Http.Polly" Version="$(MicrosoftExtensionsVersion)"/>
    <PackageReference Update="Microsoft.Extensions.Logging" Version="$(MicrosoftExtensionsVersion)"/>
    <PackageReference Update="Microsoft.Extensions.Logging.Abstractions" Version="$(MicrosoftExtensionsVersion)"/>
    <PackageReference Update="Microsoft.Extensions.Logging.Console" Version="$(MicrosoftExtensionsVersion)"/>
    <PackageReference Update="Microsoft.Extensions.Options" Version="$(MicrosoftExtensionsVersion)"/>
    <PackageReference Update="Microsoft.Extensions.Options.ConfigurationExtensions" Version="$(MicrosoftExtensionsVersion)"/>
  </ItemGroup>
</Project>
