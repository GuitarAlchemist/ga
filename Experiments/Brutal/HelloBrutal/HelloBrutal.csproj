<Project Sdk="Microsoft.NET.Sdk">

  <!-- M1 of the BRUTAL evaluation (GuitarAlchemist/gaia#257): one window through BRUTAL's GLFW binding, keyboard input,
       clean exit. Exact package versions, and a lock file for the transitive ones. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Ahwoo.Brutal.Core" Version="[2026.10.1]" />
    <PackageReference Include="Ahwoo.Brutal.Glfw" Version="[2026.10.4]" />
  </ItemGroup>

</Project>
