<Project Sdk="Microsoft.NET.Sdk">

  <!-- The part of the 3D Tiles demo that needs no window: geodesy in doubles, the tileset tree, the selection by
       screen-space error, GLB and Draco decoding. No BRUTAL reference, so it is tested without a GPU. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>GeoTiles</RootNamespace>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- Draco in managed code (MIT): Google's tiles compress their geometry with KHR_draco_mesh_compression. -->
    <PackageReference Include="Openize.Drako" Version="[1.4.4]" />
  </ItemGroup>

</Project>
