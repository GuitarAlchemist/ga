<Project Sdk="Microsoft.NET.Sdk">

  <!-- Lego's command line: the logic tests (test), the library (blocks) and a scene's description or refusal as JSON
       (describe). It is also the smallest way in for another tool, such as IX: run it, read its JSON. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Tests.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Lego\Lego.fsproj" />
  </ItemGroup>

</Project>
