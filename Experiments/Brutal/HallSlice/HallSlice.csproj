<Project Sdk="Microsoft.NET.Sdk">

  <!-- M2 of the BRUTAL evaluation (GuitarAlchemist/gaia#257): a small Observatory slice drawn with Vulkan through
       BRUTAL's bindings, shaders compiled at start-up with its ShaderC binding. Exact versions and a lock file. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Ahwoo.Brutal.Core" Version="[2026.10.1]" />
    <PackageReference Include="Ahwoo.Brutal.Glfw" Version="[2026.10.4]" />
    <PackageReference Include="Ahwoo.Brutal.Vulkan" Version="[2026.10.2]" />
    <PackageReference Include="Ahwoo.Brutal.Vulkan.Abstractions" Version="[2026.10.2]" />
    <PackageReference Include="Ahwoo.Brutal.ShaderC" Version="[2026.10.2]" />
  </ItemGroup>

  <!-- Lego scenes (the lego option): generated and validated by the F# library, materialized here as the hall's boxes. -->
  <ItemGroup>
    <ProjectReference Include="..\Lego\Lego.fsproj" />
  </ItemGroup>

</Project>
