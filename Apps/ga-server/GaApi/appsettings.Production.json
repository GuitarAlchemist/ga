  "AI": {
    "Embedding": {
      "routing": {
        "Model": "bge-large"
      }
    },
    "Routing": {
      "MinConfidence": 0.64,
      "AmbiguousBelow": 0.75,
      "MinMargin": 0.03
    }
  }
}
