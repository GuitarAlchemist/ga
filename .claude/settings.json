{
  "env": {
    "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE": "40"
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/bin/ga-hooks\" dsl-changed"
          }
        ]
      },
      {
        "matcher": "Edit|Write|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/bin/ga-hooks\" digest-activity-tracker"
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/bin/ga-hooks\" ai-annotation-scan"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/bin/ga-hooks\" pr-rationale-capture"
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/bin/ga-hooks\" ai-annotation-merge-gate"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/bin/ga-hooks\" digest-staleness-nudge"
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/bin/ga-hooks\" correction-detector"
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/bin/ga-hooks\" loops-goals-tracker prompt"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/bin/ga-hooks\" precompact-digest"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "go -C \"$CLAUDE_PROJECT_DIR/go/claudehooks\" run ./cmd/ga-hooks session-start",
            "timeout": 120
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/bin/ga-hooks\" session-pr-check"
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/bin/ga-hooks\" digest-stop-finalize"
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/bin/ga-hooks\" loops-goals-tracker stop"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "context7@claude-plugins-official": true,
    "coding-tutor@compound-engineering-plugin": true,
    "compound-engineering@compound-engineering-plugin": true,
    "ga@guitar-alchemist": true,
    "frontend-design@claude-plugins-official": true,
    "code-review@claude-plugins-official": true,
    "playwright@claude-plugins-official": true,
    "feature-dev@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true,
    "ralph-loop@claude-plugins-official": true,
    "chrome-devtools-mcp@claude-plugins-official": true,
    "greptile@claude-plugins-official": true,
    "huggingface-skills@claude-plugins-official": true,
    "microsoft-docs@claude-plugins-official": true,
    "atomic-agents@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "guitar-alchemist": {
      "source": {
        "source": "directory",
        "path": "."
      }
    }
  }
}
